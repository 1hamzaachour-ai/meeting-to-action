# Copy this file to .env and fill in what you use. An empty value means "not set".
# The app starts with nothing configured and tells you what is missing.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# When set, uploads and job status require the header "X-API-Key: <value>".
# Mandatory when ENVIRONMENT=production.
API_KEY=

# --- LLM (Phase 2) ---
# "anthropic" (Claude, billed) or "groq" (open-weight model, has a free plan with tight limits).
LLM_PROVIDER=anthropic
# With LLM_PROVIDER=groq: https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low, medium or high
GROQ_REASONING_EFFORT=medium
# https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# How hard the model thinks: low, medium, high, xhigh or max. Higher costs more.
LLM_EFFORT=medium
# Language of the tasks written to Notion, e.g. French. Empty: the meeting's own language.
TASK_LANGUAGE=

# --- Speech-to-text (Phase 5): needed only to upload recordings (.mp3, .m4a) ---
# "openai" calls a hosted API. "local" runs a Hugging Face model on this machine
# (see requirements-local-stt.txt).
STT_PROVIDER=openai
# https://platform.openai.com -> API keys
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
# With STT_PROVIDER=local: a Whisper model fine-tuned on Tunisian speech (large download).
LOCAL_STT_MODEL=oddadmix/Whisperv3-tunisian-codeswitch
# What recordings contain unless the upload says otherwise: derja, fr, en, ar or auto.
STT_DEFAULT_LANGUAGE=derja
# Names and terms to spell right in every recording, separated by commas.
STT_KEYWORDS=

# --- Notion (Phase 3) ---
# The integration's "Internal Integration Secret".
NOTION_TOKEN=
# The database's id, or simply its full URL copied from the browser.
NOTION_DATABASE_ID=
# Column names, if yours differ from these defaults.
NOTION_OWNER_PROPERTY=Owner
NOTION_DUE_PROPERTY=Due
NOTION_PRIORITY_PROPERTY=Priority
NOTION_MEETING_PROPERTY=Meeting

# --- Zoom (Phase 4) ---
# The "Secret Token" on the Feature page of your Server-to-Server OAuth app.
ZOOM_WEBHOOK_SECRET_TOKEN=
# Optional: the app's credentials, used if Zoom refuses the token sent with an event.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Add 127.0.0.1 only to try scripts/send_zoom_test_event.py on your machine.
ZOOM_DOWNLOAD_HOSTS=zoom.us,zoomgov.com

# --- Limits ---
# Largest transcript accepted, in bytes (1 MiB).
MAX_UPLOAD_BYTES=1048576
# Largest recording accepted, in bytes. 25 MB is the hosted API's own limit.
MAX_AUDIO_UPLOAD_BYTES=25000000
# Transcripts processed at the same time; the rest wait as "queued".
MAX_CONCURRENT_JOBS=3
# Jobs kept in memory for status polling.
MAX_JOBS_IN_MEMORY=500
